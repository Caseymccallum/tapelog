# binaries & build output (root-level builds only — never a source dir)
bin/
dist/
/tapelog
/tapelog.exe

# session logs are user data — never commit
*.jsonl
!examples/calls.jsonl
!examples/trajectory-demo/agent.jsonl
!test-fixtures/queue-session.jsonl
!test-fixtures/m14.1-gateway/*.jsonl
# The fictional demo recordings ARE part of the product: the Getting Started walkthrough
# ends with `lab suite --dir examples/regression-demo`, and a clone without them cannot
# run its own documentation. (Found while exporting the public tree, which uses git.)
!examples/regression-demo/*.jsonl
!spec/test-vectors/*.jsonl

# checkpoint artifacts are user data too (tapelog checkpoint output)
*.checkpoint.json
ckpt*.json

# blob stores (record/mux --blob-threshold out-of-band payloads)
*.blobs/

# editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Go
coverage.out
web-out.txt
web-err.txt
gr-check.log
gr-check.log
*.log
# transient e2e/demo output (NEVER commit these)
*-out.txt
*-err.txt
*-e2e*
junit.xml
smoke-junit.xml
examples/trajectory-demo/scenario-tampered.yaml
# blanket: transient test output at repo root (*.md is our doc format)
/*.txt
# M5.1 policy-pack regression evidence: fictional sample calls, never recordings
!docs/reviews/evidence/**/*.jsonl

# M8.1: local regression-lab demo evidence (regenerate with tools/gen-m6-demo)
/m8-lab-demo/
/m7-lab-demo/

# M15 local scratch (release-engineering output, never committed)
.m15/

# M15 release-candidate output (local only)
dist-m15/

# public tree export (build artifact, never committed)
dist-public/

# local build + design scratch (never published)
.prism/
